The temporary files of lpr and diff are in TMPDIR, as POSIX has it of
the programs that make them, and in /tmp when it is unset: a system may
have no /tmp.

--- a/editors/diff.c
+++ b/editors/diff.c
@@ -730,10 +730,12 @@
 		 * When we meet non-seekable file, we must make a temp copy.
 		 */
 		if (lseek(fd, 0, SEEK_SET) == -1 && errno == ESPIPE) {
-			char name[] = "/tmp/difXXXXXX";
+			const char *dir = getenv("TMPDIR");
+			char *name = concat_path_file(dir && dir[0] ? dir : "/tmp", "difXXXXXX");
 			int fd_tmp = xmkstemp(name);
 
 			unlink(name);
+			free(name);
 			if (bb_copyfd_eof(fd, fd_tmp) < 0)
 				xfunc_die();
 			if (fd != STDIN_FILENO)
--- a/printutils/lpr.c
+++ b/printutils/lpr.c
@@ -95,7 +95,7 @@
 		LPQ_DELETE      = 1 << 3, // -d: delete job(s)
 		LPQ_FORCE       = 1 << 4, // -f: force waiting job(s) to be printed
 	};
-	char tempfile[sizeof("/tmp/lprXXXXXX")];
+	char *tempfile = NULL;
 	const char *job_title;
 	const char *printer_class = "";   // printer class, max 32 char
 	const char *queue;                // name of printer queue
@@ -190,7 +190,8 @@
 
 		// if data file is stdin, we need to dump it first
 		if (LONE_DASH(*argv)) {
-			strcpy(tempfile, "/tmp/lprXXXXXX");
+			const char *dir = getenv("TMPDIR");
+			tempfile = concat_path_file(dir && dir[0] ? dir : "/tmp", "lprXXXXXX");
 			dfd = xmkstemp(tempfile);
 			bb_copyfd_eof(STDIN_FILENO, dfd);
 			xlseek(dfd, 0, SEEK_SET);
