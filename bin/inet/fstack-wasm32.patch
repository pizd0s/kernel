         void *arg, int pri, enum intr_type flags, void **cookiep)
 {
+    struct ff_swi *swi;
+
+    if (ff_swi_count == nitems(ff_swis))
+        return (ENOMEM);
+    swi = &ff_swis[ff_swi_count++];
