+void ff_hardclock_ticks(int n);
+int ff_callout_next(void);
+
+/*
+ * The clock of a loop that does not tick when nothing is due: n ticks at
+ * once, the callouts of them run, and how many ticks until the first
+ * callout runs, or -1 for none. A callout of time t runs at the tick after
+ * it, as softclock runs those of the ticks before ticks.
+ */
+void
+ff_hardclock_ticks(int n)
+{
+    if (n <= 0)
+        return;
+    atomic_add_int(&ticks, n);
+    callout_tick();
+    tc_ticktock(n * ((hz + 999)/1000));
+    cpu_tick_calibration();
+}
+
+int
+ff_callout_next(void)
+{
+    struct callout_cpu *cc = CC_SELF();
+    struct callout *c;
+    int i;
+
+    if (!cc_earliest_known || cc_earliest - ticks < 0) {
+        cc_earliest_known = 0;
+        for (i = 0; i < callwheelsize; i++) {
+            LIST_FOREACH(c, &cc->cc_callwheel[i], c_links.le) {
+                if (!cc_earliest_known || c->c_time - cc_earliest < 0) {
+                    cc_earliest = c->c_time;
+                    cc_earliest_known = 1;
+                }
+            }
+        }
+    }
+    if (!cc_earliest_known)
+        return (-1);
+    return (cc_earliest - ticks >= 0 ? cc_earliest - ticks + 1 : 1);
+}
 
