mc calls functions through pointers of other types, as GLib does
(glib-function-types.patch): a group destroys its widgets and tar runs a
header's overrides through g_list_foreach with a function of another
type, and the events' trees compare names with g_ascii_strcasecmp, a
function of two parameters, where a GCompareDataFunc of three is called.
The loops are written out, and the trees get a function of the type
called.

--- a/lib/event/event.c
+++ b/lib/event/event.c
@@ -45,6 +45,14 @@
 /*** file scope functions ************************************************************************/
 /* --------------------------------------------------------------------------------------------- */
 /*** public functions ****************************************************************************/
+static gint
+mc_event_name_compare (gconstpointer a, gconstpointer b, gpointer user_data)
+{
+    (void) user_data;
+
+    return g_ascii_strcasecmp ((const char *) a, (const char *) b);
+}
+
 /* --------------------------------------------------------------------------------------------- */
 
 gboolean
@@ -59,7 +67,7 @@
