+// The descriptor of a stream freopen gives no name, with the mode: the
+// access asked must be the descriptor's, or it is open for both (EBADF
+// otherwise); O_APPEND is set or cleared, "w" truncates, "e" sets
+// FD_CLOEXEC, and the offset is the start but in append mode.
+static int __freopen_descriptor(FILE* fp, int mode_flags) {
+  int fd = fp->_file;
+  int fd_flags = fcntl(fd, F_GETFL);
+  if (fd_flags == -1) return -1;
+  int access = fd_flags & O_ACCMODE;
+  if (access != O_RDWR && access != (mode_flags & O_ACCMODE)) {
+    errno = EBADF;
+    return -1;
+  }
+  if (((fd_flags ^ mode_flags) & O_APPEND) != 0 &&
+      fcntl(fd, F_SETFL, (fd_flags & ~O_APPEND) | (mode_flags & O_APPEND)) == -1) {
+    return -1;
+  }
+  if ((mode_flags & O_TRUNC) != 0) ftruncate(fd, 0);
+  if ((mode_flags & O_APPEND) == 0) lseek(fd, 0, SEEK_SET);
+  if ((mode_flags & O_CLOEXEC) != 0) fcntl(fd, F_SETFD, FD_CLOEXEC);
+  return fd;
+}
