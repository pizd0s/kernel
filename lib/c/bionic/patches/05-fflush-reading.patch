+// What fflush does to a stream reading, as POSIX has it: a file capable of
+// seeking gets the stream's position as its offset, and what the stream
+// read ahead or ungetc pushed back is dropped; a file of no position keeps
+// its offset, and errno.
+static int __sflush_read(FILE* fp) {
+  if (fp->_r <= 0 && !HASUB(fp)) return 0;
+  ErrnoRestorer errno_restorer;
+  off64_t position = __ftello64_unlocked(fp);
+  if (position != -1 && __seek_unlocked(fp, position, SEEK_SET) != -1) {
+    if (HASUB(fp)) FREEUB(fp);
+    fp->_p = fp->_bf._base;
+    fp->_r = 0;
+  }
+  return 0;
+}
+
+// fflush of one stream: what it has to write written, or what it read
+// given back.
+static int __fflush_one(FILE* fp) {
+  return (fp->_flags & __SRD) ? __sflush_read(fp) : __sflush(fp);
 }
 
