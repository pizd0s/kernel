A stream's first buffer asks isatty of a character device, which leaves
ENOTTY in errno where it is no terminal: the printf, fputs or getc that
made the buffer succeeds with errno changed. C lets it, but programs read
errno after such a call, as busybox's printf does after each conversion
(exit 1 on the console), and glibc keeps errno there.

--- a/libc/stdio/stdio.cpp
+++ b/libc/stdio/stdio.cpp
@@ -352,7 +352,10 @@
   flags |= __SMBF;
   fp->_bf._base = fp->_p = p;
   fp->_bf._size = size;
-  if (couldbetty && isatty(fp->_file)) flags |= __SLBF;
+  if (couldbetty) {
+    ErrnoRestorer errno_restorer;
+    if (isatty(fp->_file)) flags |= __SLBF;
+  }
   fp->_flags |= flags;
 }
 
