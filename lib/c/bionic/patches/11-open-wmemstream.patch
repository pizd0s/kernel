-	size_t		 nmc, len, end;
+	size_t		 len, end;
+	const char	*at = b, *stop = b + l;
 
 	end = (st->pos + l);
 
@@ -59,11 +60,20 @@
 		st->size = sz;
 	}
 
-	nmc = (st->size - st->pos) * sizeof(wchar_t);
-	len = mbsnrtowcs(st->string + st->pos, &b, nmc, l, &st->mbs);
-	if (len == (size_t)-1)
-		return (-1);
-	st->pos += len;
+	while (at < stop) {
+		const char *from = at;
+
+		len = mbsnrtowcs(st->string + st->pos, &at, stop - at,
+		    st->size - st->pos, &st->mbs);
+		if (len == (size_t)-1)
+			return (-1);
+		st->pos += len;
+		if (at == NULL) {
+			/* A null character, which it stored. */
+			at = (const char *)memchr(from, '\0', stop - from) + 1;
+			st->pos++;
+		}
+	}
 
 	if (st->pos > st->len) {
 		st->len = st->pos;
@@ -72,7 +82,7 @@
 
