%n stores the count of what was written, as C has it, into the object
of the type its length names; Android's printf aborts. %m is errno's
message by POSIX's strerror_r, which lib/c's is, not GNU's; '#' changes
nothing, lib/c having no names of errno's values (strerrorname_np).

--- a/libc/stdio/printf_common.h
+++ b/libc/stdio/printf_common.h
@@ -523,7 +523,25 @@
           ADDTYPE(T_DOUBLE);
         break;
       case 'n':
-        __fortify_fatal("%%n not allowed on Android");
+        // A pointer to the object %n's count goes into (vfprintf.cpp);
+        // of a signed char, a pointer as a char's is.
+        if (flags & LLONGINT)
+          ADDTYPE(TP_LLONG);
+        else if (flags & LONGINT)
+          ADDTYPE(TP_LONG);
+        else if (flags & SHORTINT)
+          ADDTYPE(TP_SHORT);
+        else if (flags & CHARINT)
+          ADDTYPE(TP_CHAR);
+        else if (flags & PTRINT)
+          ADDTYPE(TP_PTRINT);
+        else if (flags & SIZEINT)
+          ADDTYPE(TP_SSIZEINT);
+        else if (flags & MAXINT)
+          ADDTYPE(TP_MAXINT);
+        else
+          ADDTYPE(TP_INT);
+        continue; /* no output */
       case 'O':
         flags |= LONGINT;
         [[fallthrough]];
