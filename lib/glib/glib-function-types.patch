+/* A GCompareFunc called where a GCompareDataFunc is: the function is the
+ * user data. */
+static gint
+compare_func_with_data (gconstpointer a,
+                        gconstpointer b,
+                        gpointer      user_data)
+{
+  GCompareFunc func = (GCompareFunc) user_data;
+
+  return func (a, b);
+}
