mbsinit of a state that c16rtomb holds a high surrogate in, or
mbrtoc16 the low half of a pair, said it was the initial state, as C has
it not: both kept the half before the state of char32_t's they pass on,
where mbsinit looks for that state. The state of the two (mblocal.h) is
now the state of char32_t's at its start, where it is for mbrtowc too,
and the half out of its way, which mbsinit sees as well.

--- a/lib/libc/locale/c16rtomb.c
+++ b/lib/libc/locale/c16rtomb.c
@@ -30,11 +30,6 @@
 #include <uchar.h>
 #include "mblocal.h"
 
-typedef struct {
-	char16_t	lead_surrogate;
-	mbstate_t	c32_mbstate;
-} _Char16State;
-
 size_t
 c16rtomb_l(char * __restrict s, char16_t c16, mbstate_t * __restrict ps,
     locale_t locale)
@@ -50,24 +45,24 @@
 	/* If s is a null pointer, the value of parameter c16 is ignored. */
 	if (s == NULL) {
 		c32 = 0;
-	} else if (cs->lead_surrogate >= 0xd800 &&
-	    cs->lead_surrogate <= 0xdbff) {
+	} else if (cs->c16.surrogate >= 0xd800 &&
+	    cs->c16.surrogate <= 0xdbff) {
 		/* We should see a trail surrogate now. */
 		if (c16 < 0xdc00 || c16 > 0xdfff) {
 			errno = EILSEQ;
 			return ((size_t)-1);
 		}
-		c32 = 0x10000 + ((cs->lead_surrogate & 0x3ff) << 10 |
+		c32 = 0x10000 + ((cs->c16.surrogate & 0x3ff) << 10 |
 		    (c16 & 0x3ff));
 	} else if (c16 >= 0xd800 && c16 <= 0xdbff) {
 		/* Store lead surrogate for next invocation. */
-		cs->lead_surrogate = c16;
+		cs->c16.surrogate = c16;
 		return (0);
 	} else {
 		/* Regular character. */
 		c32 = c16;
 	}
-	cs->lead_surrogate = 0;
+	cs->c16.surrogate = 0;
 
 	return (c32rtomb_l(s, c32, &cs->c32_mbstate, locale));
 }
--- a/lib/libc/locale/mblocal.h
+++ b/lib/libc/locale/mblocal.h
@@ -37,7 +37,23 @@
 #define	_MBLOCAL_H_
 
 #include <runetype.h>
+#include <uchar.h>
 #include "xlocale_private.h"
+
+/*
+ * The state of mbrtoc16 and c16rtomb: the state of char32_t's at its
+ * start, where mbrtowc's is, and the UTF-16 half the next call gives or
+ * takes out of its way; mbsinit sees both.
+ */
+typedef union {
+	mbstate_t	c32_mbstate;
+	struct {
+		char		c32[64];
+		char16_t	surrogate;
+	} c16;
+} _Char16State;
+
+_Static_assert(sizeof(_Char16State) == sizeof(mbstate_t), "mbstate_t is too small");
 
 #define	SS2	0x008e
 #define SS3	0x008f
