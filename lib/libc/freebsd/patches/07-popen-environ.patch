environ is the program's variable, which libc.wasm has no name for: the
shell is run by execv, the kernel's, which reads the program's environ.

--- a/lib/libc/gen/popen.c
+++ b/lib/libc/gen/popen.c
@@ -155,7 +155,7 @@
 		}
 		SLIST_FOREACH(p, &pidlist, next)
 			(void)_close(fileno(p->fp));
-		_execve(_PATH_BSHELL, argv, environ);
+		execv(_PATH_BSHELL, argv);
 		_exit(127);
 		/* NOTREACHED */
 	}
