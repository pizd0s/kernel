+/*
+ * What fflush does to one stream: what it has to write written, or, of a
+ * stream reading, its position given to its file where the file has one.
+ */
+int
+__fflush_one(FILE *fp)
+{
+	fpos_t pos;
+	int serrno;
+
+	if ((fp->_flags & __SRD) == 0)
+		return (__sflush(fp));
+	if (fp->_r <= 0 && !HASUB(fp))
+		return (0);
+	serrno = errno;
+	if (_ftello(fp, &pos) == 0 && _sseek(fp, pos, SEEK_SET) != -1) {
+		if (HASUB(fp))
+			FREEUB(fp);
+		fp->_p = fp->_bf._base;
+		fp->_r = 0;
+	}
+	errno = serrno;
+	return (0);
+}
+
 static int
 sflush_locked(FILE *fp)
 {
 	int	ret;
 
 	FLOCKFILE_CANCELSAFE(fp);
-	ret = __sflush(fp);
+	ret = __fflush_one(fp);
 	FUNLOCKFILE_CANCELSAFE();
 	return (ret);
 }
