A stream's first buffer asks isatty of a character device, which leaves
ENOTTY in errno where it is no terminal: the printf, fputs or getc that
made the buffer succeeds with errno changed. C lets it, but programs read
errno after such a call, as busybox's printf does after each conversion,
and glibc keeps errno there.

--- a/lib/libc/stdio/makebuf.c
+++ b/lib/libc/stdio/makebuf.c
@@ -38,6 +38,7 @@
 #include "namespace.h"
 #include <sys/types.h>
 #include <sys/stat.h>
+#include <errno.h>
 #include <unistd.h>
 #include <stdio.h>
 #include <stdlib.h>
@@ -77,8 +78,13 @@
 	flags |= __SMBF;
 	fp->_bf._base = fp->_p = p;
 	fp->_bf._size = size;
-	if (couldbetty && isatty(fp->_file))
-		flags |= __SLBF;
+	if (couldbetty) {
+		int serrno = errno;
+
+		if (isatty(fp->_file))
+			flags |= __SLBF;
+		errno = serrno;
+	}
 	fp->_flags |= flags;
 }
 
