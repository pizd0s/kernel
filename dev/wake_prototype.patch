+++ b/lib/goruntime/seat.go
@@ -0,0 +1,242 @@
+// Seats, for vm's kernel (bin/vm): where a goroutine sleeps for a wait of
+// its process and is rung awake, with none of a channel's queue and lock;
+// and a switch to another goroutine at once: one that wakes a sleeper and
+// sleeps right after hands its thread over to it, as a call of L4's does
+// its caller's, and the sleeper runs with no turn in the scheduler's
+// queues.
+
+package runtime
+
+import (
+	"internal/runtime/atomic"
+	"unsafe"
+)
+
+// A Seat is one goroutine's: nothing (0), rung while its goroutine was
+// awake (seatRung), or the goroutine asleep there. Its goroutine alone
+// sleeps there; any rings it.
+type Seat struct {
+	v atomic.Uintptr
+}
+
+const seatRung = 1
+
+// How the calling goroutine wakes the sleepers it rings: each made
+// runnable as any goroutine is, another thread woken for it (WakesAny);
+// each made runnable to run next on the caller's thread, with no other
+// woken, as the caller sleeps soon (WakesQuiet); or the first one kept,
+// to run in the caller's place at once when it sleeps, and the rest
+// quiet (WakesKept).
+const (
+	WakesAny = iota
+	WakesQuiet
+	WakesKept
+)
+
+// gSeat is a goroutine's way of waking, and the sleeper it keeps.
+type gSeat struct {
+	wakes     uint8
+	quieted   bool
+	successor guintptr
+}
+
+// Ring rings the seat: its goroutine wakes if it sleeps there, as the
+// caller wakes (Wakes), and its next Sleep returns at once otherwise.
+func (s *Seat) Ring() {
+	for {
+		v := s.v.Load()
+
+		switch {
+		case v == 0:
+			if s.v.CompareAndSwap(0, seatRung) {
+				return
+			}
+		case v == seatRung:
+			// A write the caller made for the sleeper to find is seen
+			// by whoever takes the ring from now on.
+			if s.v.CompareAndSwap(seatRung, seatRung) {
+				return
+			}
+		default:
+			if s.v.CompareAndSwap(v, 0) {
+				gp := getg()
+
+				switch {
+				case gp.seat.wakes == WakesAny || gp != gp.m.curg:
+					goready((*g)(unsafe.Pointer(v)), 1)
+				case gp.seat.wakes == WakesKept && gp.seat.successor == 0:
+					gp.seat.successor = guintptr(v)
+				default:
+					systemstack(func() {
+						next := (*g)(unsafe.Pointer(v))
+						mp := acquirem()
+						pp := mp.p.ptr()
+
+						// One that waits to run on this P already
+						// says the caller sleeps not so soon: a thread
+						// is woken for them.
+						alone := pp.runnext == 0 && runqempty(pp)
+						casgstatus(next, _Gwaiting, _Grunnable)
+						runqput(pp, next, true)
+
+						if alone {
+							gp.seat.quieted = true
+						} else {
+							wakep()
+						}
+
+						releasem(mp)
+					})
+				}
+
+				return
+			}
+		}
+	}
+}
+
+// Wakes sets how the calling goroutine wakes from now on, and tells
+// whether it woke any quietly since it was last asked. One that keeps no
+// more makes a sleeper it kept runnable.
+func Wakes(how uint8) (quieted bool) {
+	gp := getg()
+	gp.seat.wakes = how
+	quieted = gp.seat.quieted
+	gp.seat.quieted = false
+
+	if how != WakesKept && gp.seat.successor != 0 {
+		next := gp.seat.successor.ptr()
+		gp.seat.successor = 0
+		goready(next, 1)
+	}
+
+	return quieted
+}
+
+// Wakep wakes a thread for what the caller's P has to run, if one idles:
+// the caller woke quietly and sleeps not.
+func Wakep() {
+	mp := acquirem()
+	pp := mp.p.ptr()
+	waits := pp.runnext != 0 || !runqempty(pp)
+	releasem(mp)
+
+	if waits {
+		wakep()
+	}
+}
+
+// Sleep is the calling goroutine asleep at its seat until it is rung; a
+// ring that came since its last Sleep is taken at once. A sleeper it
+// kept runs at once in its place, on its thread.
+func (s *Seat) Sleep() {
+	gp := getg()
+
+	if gp.seat.successor != 0 {
+		mp := acquirem()
+		mp.waitlock = unsafe.Pointer(s)
+		gp.waitreason = waitReasonCoroutine
+		releasem(mp)
+		mcall(seatSwitch)
+
+		return
+	}
+
+	if s.v.Load() == seatRung {
+		s.v.Store(0)
+
+		return
+	}
+
+	if traceEnabled() {
+		gopark(seatPark, unsafe.Pointer(s), waitReasonCoroutine, traceBlockGeneric, 1)
+
+		return
+	}
+
+	mp := acquirem()
+	mp.waitlock = unsafe.Pointer(s)
+	gp.waitreason = waitReasonCoroutine
+	releasem(mp)
+	mcall(seatSleep)
+}
+
+// seatSleep parks gp at its seat, as park_m does, and runs the goroutine
+// that is next on its P at once, the one gp woke, when nothing else asks
+// for the scheduler: a stop of the world, a call at a safe point, a
+// timer of the P's, the collector's work.
+func seatSleep(gp *g) {
+	mp := getg().m
+	s := (*Seat)(mp.waitlock)
+	mp.waitlock = nil
+	pp := mp.p.ptr()
+	casgstatus(gp, _Grunning, _Gwaiting)
+	dropg()
+
+	if !seatPark(gp, unsafe.Pointer(s)) {
+		casgstatus(gp, _Gwaiting, _Grunnable)
+		execute(gp, true)
+	}
+
+	if next := pp.runnext; next != 0 && !sched.gcwaiting.Load() && pp.runSafePointFn == 0 && pp.timers.wakeTime() == 0 && gcBlackenEnabled == 0 && pp.runnext.cas(next, 0) {
+		execute(next.ptr(), true)
+	}
+
+	schedule()
+}
+
+// seatPark puts the goroutine that parks in its seat, unless it was rung
+// meanwhile: it runs on then, the ring taken.
+func seatPark(gp *g, s unsafe.Pointer) bool {
+	seat := (*Seat)(s)
+
+	if seat.v.CompareAndSwap(0, uintptr(unsafe.Pointer(gp))) {
+		return true
+	}
+
+	seat.v.Store(0)
+
+	return false
+}
+
+// seatSwitch puts gp to sleep at its seat and runs the sleeper it kept,
+// on the same thread and P, as coroswitch_m runs a coroutine: with none
+// of the scheduler's queues. A gp rung meanwhile stays runnable, behind
+// the sleeper.
+func seatSwitch(gp *g) {
+	mp := getg().m
+	s := (*Seat)(mp.waitlock)
+	mp.waitlock = nil
+	next := gp.seat.successor.ptr()
+	gp.seat.successor = 0
+	gp.seat.wakes = WakesAny
+	pp := mp.p.ptr()
+
+	if !gp.atomicstatus.CompareAndSwap(_Grunning, _Gwaiting) {
+		casgstatus(gp, _Grunning, _Gwaiting)
+	}
+
+	setMNoWB(&gp.m, nil)
+
+	if !s.v.CompareAndSwap(0, uintptr(unsafe.Pointer(gp))) {
+		s.v.Store(0)
+		casgstatus(gp, _Gwaiting, _Grunnable)
+		runqput(pp, gp, false)
+	}
+
+	setGNoWB(&mp.curg, next)
+	setMNoWB(&next.m, mp)
+
+	if goroutineProfile.active {
+		tryRecordGoroutineProfile(next, nil, osyield)
+	}
+
+	if !next.atomicstatus.CompareAndSwap(_Gwaiting, _Grunning) {
+		casgstatus(next, _Gwaiting, _Grunnable)
+		casgstatus(next, _Grunnable, _Grunning)
+	}
+
+	next.preempt = false
+	next.stackguard0 = next.stack.lo + stackGuard
+	gogo(&next.sched)
+}
